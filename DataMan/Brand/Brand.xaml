<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Hex must match BrandSpec.Primary. Runtime writes to Application.Resources crash WinUI 3. -->
    <Color x:Key="SystemAccentColor">#12E0C8</Color>
    <Color x:Key="SystemAccentColorLight1">#4AE8D6</Color>
    <Color x:Key="SystemAccentColorLight2">#3CE66A</Color>
    <Color x:Key="SystemAccentColorLight3">#7AEE9A</Color>
    <Color x:Key="SystemAccentColorDark1">#00D4FF</Color>
    <Color x:Key="SystemAccentColorDark2">#0EA3A0</Color>
    <Color x:Key="SystemAccentColorDark3">#0A6B6A</Color>
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#12E0C8" />
    <SolidColorBrush x:Key="BrandFieldBrush" Color="#06090E" />
    <LinearGradientBrush x:Key="BrandAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3CE66A" Offset="0" />
        <GradientStop Color="#12E0C8" Offset="0.55" />
        <GradientStop Color="#00D4FF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
